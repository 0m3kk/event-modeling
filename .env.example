# Google Drive Integration Configuration
# 1. Google OAuth 2.0 Web Client ID from Google Cloud Console
#    Add http://localhost:5173 and tauri://localhost to Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=

# 2. (Optional) Direct Google Access Token (for local development or quick testing)
#    If set, Google Drive operations will use this token directly without requiring login
VITE_GOOGLE_ACCESS_TOKEN=
