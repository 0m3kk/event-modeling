# Google Drive Integration Configuration

# 1. Web build (browser) - Google OAuth 2.0 "Web application" Client ID
#    Add http://localhost:5173 to Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=

# 2. Desktop build (Tauri) - Google OAuth 2.0 "Desktop app" Client ID
#    Tauri's webview blocks the GIS popup, so the desktop app signs in through the
#    system browser with a loopback redirect (http://127.0.0.1:<port>). Loopback
#    redirects only work with a "Desktop app" OAuth client, NOT a "Web application"
#    client, so create a separate client for desktop and paste its ID here.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
# Optional: only needed if your Google client requires a secret on the token exchange.
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# 3. (Optional) Direct Google Access Token (for local development or quick testing)
#    If set, Google Drive operations will use this token directly without requiring login
VITE_GOOGLE_ACCESS_TOKEN=
