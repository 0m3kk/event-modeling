//! Queries declared by the `{{ module }}` domain.
//!
//! Each query is generated as a params struct plus a response struct.
//! Validation is generated for the params struct only.

{% for regex in query_regexes %}
pub(crate) static {{ regex.name }}: std::sync::LazyLock<regex::Regex> =
    std::sync::LazyLock::new(|| {
        regex::Regex::new({{ regex.pattern|str_lit }}).expect("invalid validation pattern")
    });

{% endfor %}
{% for validator in query_validators %}
fn {{ validator.name }}(value: &{{ validator.parameter_type }}) -> Result<(), validator::ValidationError> {
{%- if validator.optional %}
    let value = *value;
{%- endif %}
{%- if validator.array %}
    let values = value.as_slice();
{%- else %}
    let values = std::slice::from_ref(value);
{%- endif %}
    for value in values {
{%- for check in validator.checks %}
        if !{{ check.expression }} {
            return Err(validator::ValidationError::new({{ check.code|str_lit }}));
        }
{%- endfor %}
    }
    Ok(())
}

{% endfor %}
{% for query in queries %}
{%- for line in query.doc_lines %}
/// {{ line }}
{%- endfor %}
#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize, validator::Validate)]
pub struct {{ query.params_name }} {
{%- for field in query.params %}
{%- for line in field.doc_lines %}
    /// {{ line }}
{%- endfor %}
{%- if field.validation_attrs %}
    #[validate({{ field.validation_attrs|join(", ") }})]
{%- endif %}
{%- if not field.required %}
    #[serde(default, skip_serializing_if = "Option::is_none")]
{%- endif %}
    pub {{ field.rust_name }}: {{ field.rtype }},
{%- endfor %}
}

/// Response produced by [`{{ query.params_name }}`].
#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
pub struct {{ query.response_name }} {
{%- for field in query.responses %}
{%- for line in field.doc_lines %}
    /// {{ line }}
{%- endfor %}
{%- if not field.required %}
    #[serde(default, skip_serializing_if = "Option::is_none")]
{%- endif %}
    pub {{ field.rust_name }}: {{ field.rtype }},
{%- endfor %}
}

{% endfor %}
