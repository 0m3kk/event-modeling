//! Data types of the `{{ module }}` domain.

{% for ty in types %}
{%- for line in ty.doc_lines %}
/// {{ line }}
{%- endfor %}
{%- if ty.kind == "object" %}
#[derive(Debug, Clone, Default, PartialEq, serde::Serialize, serde::Deserialize)]
pub struct {{ ty.rust_name }} {
{%- for field in ty.fields %}
{%- for line in field.doc_lines %}
    /// {{ line }}
{%- endfor %}
{%- if not field.required %}
    #[serde(default, skip_serializing_if = "Option::is_none")]
{%- endif %}
    pub {{ field.rust_name }}: {{ field.rtype }},
{%- endfor %}
}
{%- elif ty.kind == "enum" %}
#[derive(Debug, Clone, Copy{% if ty.variants %}, Default{% endif %}, PartialEq, Eq, Hash, serde::Serialize, serde::Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum {{ ty.rust_name }} {
{%- for variant in ty.variants %}
{%- for line in variant.doc_lines %}
    /// {{ line }}
{%- endfor %}
{%- if loop.first %}
    #[default]
{%- endif %}
    {{ variant.rust_name }},
{%- endfor %}
}

impl {{ ty.rust_name }} {
    /// The specification name of this variant.
    pub const fn as_str(&self) -> &'static str {
        match self {
{%- for variant in ty.variants %}
            Self::{{ variant.rust_name }} => {{ variant.name|snake|str_lit }},
{%- endfor %}
        }
    }
}

impl std::fmt::Display for {{ ty.rust_name }} {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.write_str(self.as_str())
    }
}
{%- elif ty.kind == "alias" %}
#[derive(Debug, Clone, Default, PartialEq{% if ty.alias.eq_hash %}, Eq, Hash{% endif %}, serde::Serialize, serde::Deserialize)]
#[serde(transparent)]
pub struct {{ ty.rust_name }}(pub {{ ty.alias.inner_rust }});

impl {{ ty.rust_name }} {
    /// Wraps a raw value in this domain type.
    pub fn new(value: impl Into<{{ ty.alias.inner_rust }}>) -> Self {
        Self(value.into())
    }
{%- if ty.alias.string_like %}

    /// Borrows the wrapped string.
    pub fn as_str(&self) -> &str {
        &self.0
    }
{%- endif %}
}

impl From<{{ ty.alias.inner_rust }}> for {{ ty.rust_name }} {
    fn from(value: {{ ty.alias.inner_rust }}) -> Self {
        Self(value)
    }
}
{%- if ty.alias.string_like %}

impl AsRef<str> for {{ ty.rust_name }} {
    fn as_ref(&self) -> &str {
        &self.0
    }
}
{%- endif %}
{%- if ty.alias.display %}

impl std::fmt::Display for {{ ty.rust_name }} {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{}", self.0)
    }
}
{%- endif %}
{%- endif %}

{% endfor %}
