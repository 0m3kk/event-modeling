//! Actors declared by the `{{ spec_name }}` specification.

{% if actors %}
/// An actor that may execute commands.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub enum Actor {
{%- for actor in actors %}
{%- for line in actor.doc_lines %}
    /// {{ line }}
{%- endfor %}
    {{ actor.rust_name }},
{%- endfor %}
}

impl Actor {
    /// Every actor declared by the specification.
    pub const ALL: &'static [Actor] = &[
{%- for actor in actors %}
        Actor::{{ actor.rust_name }},
{%- endfor %}
    ];

    /// The specification name of this actor.
    pub const fn name(&self) -> &'static str {
        match self {
{%- for actor in actors %}
            Self::{{ actor.rust_name }} => {{ actor.name|snake|str_lit }},
{%- endfor %}
        }
    }

    /// Permissions granted to this actor. A trailing `:*` is a prefix grant.
    pub const fn permissions(&self) -> &'static [&'static str] {
        match self {
{%- for actor in actors %}
            Self::{{ actor.rust_name }} => &[
{%- for permission in actor.permissions %}
                {{ permission|str_lit }},
{%- endfor %}
            ],
{%- endfor %}
        }
    }

    /// Returns `true` when this actor may execute `A`.
    pub fn can_execute<A: crate::action::Action>(&self) -> bool {
        self.can(A::action())
    }

    /// Returns `true` when this actor holds `permission`.
    ///
    /// A permission ending in `:*` grants every permission sharing the prefix,
    /// e.g. `identity:*` grants `identity:activate_account`.
    pub fn can(&self, permission: &str) -> bool {
        self.permissions().iter().any(|granted| {
            if *granted == permission {
                return true;
            }
            match granted.strip_suffix(":*") {
                Some(prefix) => {
                    permission.starts_with(prefix)
                        && permission.as_bytes().get(prefix.len()) == Some(&b':')
                }
                None => false,
            }
        })
    }
}
{% else %}
// No actors were declared by the specification.
{% endif %}
