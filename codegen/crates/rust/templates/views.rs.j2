/// Table metadata for [`{{ view.rust_name }}`].
pub const {{ view.const_name }}: ViewDefinition = ViewDefinition {
    table: {{ view.table | str_lit }},
    key: &[{% for key in view.key_columns %}{{ key | str_lit }}{% if not loop.last %}, {% endif %}{% endfor %}],
};

/// Parameters identifying one [`{{ view.rust_name }}`] projection instance.
{%- if view.params %}
#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
{%- else %}
#[derive(Debug, Clone, Default, PartialEq, serde::Serialize, serde::Deserialize)]
{%- endif %}
pub struct {{ view.rust_name }}Params {
{%- for field in view.params %}
{%- for line in field.doc_lines %}
    /// {{ line }}
{%- endfor %}
{%- if not field.required %}
    #[serde(default, skip_serializing_if = "Option::is_none")]
{%- endif %}
    pub {{ field.rust_name }}: {{ field.rtype }},
{%- endfor %}
}

impl {{ view.rust_name }}Params {
    /// Creates the params for this view.
    pub fn new({% for field in view.params %}{{ field.rust_name }}: {{ field.rtype }}{% if not loop.last %}, {% endif %}{% endfor %}) -> Self {
{%- if view.params %}
        Self {
{%- for field in view.params %}
            {{ field.rust_name }},
{%- endfor %}
        }
{%- else %}
        Self::default()
{%- endif %}
    }

    /// Event-store query selecting the events projected into this view.
    pub fn query(&self) -> event_store::Query {
        event_store::Query::from_items([
{%- for source in view.query %}
            event_store::QueryItem::new(
                vec![
{%- for ty in source.resolved_types %}
                    <{{ ty.path }} as event_store::DomainEvent>::event_type().to_string(),
{%- endfor %}
                ],
{%- if source.tags %}
                {
                    let mut tags = Vec::new();
{%- for tag in source.tags %}
{%- if tag.optional and tag.array %}
                    if let Some(values) = &self.{{ tag.rust_name }} {
                        for value in values {
                            tags.push(format!("{{ tag.tag }}:{}", event_store::tag_value(value)));
                        }
                    }
{%- elif tag.array %}
                    for value in &self.{{ tag.rust_name }} {
                        tags.push(format!("{{ tag.tag }}:{}", event_store::tag_value(value)));
                    }
{%- elif tag.optional %}
                    if let Some(value) = &self.{{ tag.rust_name }} {
                        tags.push(format!("{{ tag.tag }}:{}", event_store::tag_value(value)));
                    }
{%- else %}
                    tags.push(format!("{{ tag.tag }}:{}", event_store::tag_value(&self.{{ tag.rust_name }})));
{%- endif %}
{%- endfor %}
                    tags
                },
{%- else %}
                Vec::new(),
{%- endif %}
            ),
{%- endfor %}
        ])
    }
}
{%- if view.event_handlers %}

/// Database-backed event handlers for [`{{ view.rust_name }}`].
///
/// Every method applies one event to the persisted view and may write the
/// result back. The event types that feed this view are recorded on
/// [`{{ view.rust_name }}`].
///
/// The methods return `impl Future + Send` instead of using `async fn`, so the
/// crate does not need an `async-trait` dependency. Implement them with
/// `async fn`.
pub trait {{ view.rust_name }}Store {
    /// Error type chosen by the implementation.
    type Error;
{%- for handler in view.event_handlers %}

    /// Applies a `{{ handler.event_type }}` event to the view.
    fn {{ handler.method }}(
        &self,
        event: &{{ handler.event_path }},
        position: event_store::SequencePosition,
    ) -> impl std::future::Future<Output = Result<(), Self::Error>> + Send;
{%- endfor %}

    /// Applies one sequenced event to the view.
    ///
    /// Dispatches on the stored event type, deserializes the payload, and calls
    /// the matching `on_*` handler.
    fn apply(
        &self,
        sequenced: &event_store::SequencedEvent,
    ) -> impl std::future::Future<Output = Result<(), ViewError<Self::Error>>> + Send
    where
        Self: Sync,
    {
        async move {
            let event_type = sequenced.event.event_type.as_str();

            match event_type {
{%- for handler in view.event_handlers %}
                {{ handler.event_type | str_lit }} => {
                    let event: {{ handler.event_path }} =
                        serde_json::from_value(sequenced.event.data.clone())
                            .map_err(ViewError::Serialization)?;
                    self.{{ handler.method }}(&event, sequenced.position)
                        .await
                        .map_err(ViewError::Store)
                }
{%- endfor %}
                other => Err(ViewError::UnexpectedEvent(other.to_string())),
            }
        }
    }
}
