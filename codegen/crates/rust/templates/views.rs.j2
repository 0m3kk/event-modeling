//! Persisted read-model views of the `{{ module }}` domain.
//!
//! A view is generated as one row struct, one params struct that builds the
//! event query, and an asynchronous `Store` trait with one `on_*` handler per
//! event type the view reads. Views live in a database, so their handlers
//! return a future and the application layer owns the SQL. The store's
//! generated `apply` method dispatches events to the matching handler.

{% if views %}
/// Metadata for the PostgreSQL table backing a generated view.
#[derive(Debug, Clone, Copy)]
pub struct ViewDefinition {
    /// Table name.
    pub table: &'static str,
    /// Primary-key column names.
    pub key: &'static [&'static str],
}

/// Error returned when an event cannot be applied to a view.
#[derive(Debug)]
pub enum ViewError<E> {
    /// Event payload could not be deserialized.
    Serialization(serde_json::Error),

    /// The view store rejected the write.
    Store(E),

    /// The event type is not part of the view's query.
    UnexpectedEvent(String),
}

impl<E: std::fmt::Display> std::fmt::Display for ViewError<E> {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Self::Serialization(error) => write!(f, "serialization failed: {error}"),
            Self::Store(error) => write!(f, "view store failed: {error}"),
            Self::UnexpectedEvent(event_type) => {
                write!(f, "unexpected event type `{event_type}`")
            }
        }
    }
}

impl<E: std::error::Error + 'static> std::error::Error for ViewError<E> {
    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
        match self {
            Self::Serialization(error) => Some(error),
            Self::Store(error) => Some(error),
            Self::UnexpectedEvent(_) => None,
        }
    }
}
{% endif %}
