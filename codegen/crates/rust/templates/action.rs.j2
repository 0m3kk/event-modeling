//! Authorization metadata for commands and queries.
//!
//! Every command input struct and query params struct implements [`Action`]. The
//! returned string is the permission an [`Actor`](crate::Actor) must hold, so
//! authorization code can stay independent of the concrete command type.

/// A command or query that maps to an actor permission.
pub trait Action {
    /// Permission required to execute this action, e.g. `identity:register_account`.
    fn action() -> &'static str;
}
