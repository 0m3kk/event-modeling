[package]
name = "{{ package_name }}"
version = "{{ version }}"
edition = "2024"
description = {{ package_description|str_lit }}

[dependencies]
{%- if uses_chrono %}
chrono = { version = "0.4", features = ["serde"] }
{%- endif %}
event-store = { git = "https://github.com/0m3kk/backend-kit" }
{%- if uses_regex %}
regex = "1"
{%- endif %}
serde = { version = "1", features = ["derive"] }
{%- if uses_json or uses_state_apply %}
serde_json = "1"
{%- endif %}
{%- if uses_uuid %}
uuid = { version = "1", features = ["serde"] }
{%- endif %}
validator = { version = "0.20", features = ["derive"] }
