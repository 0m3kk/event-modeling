[package]
name = "{{ package_name }}"
version = "{{ version }}"
edition = "2024"
description = {{ package_description|str_lit }}

[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
validator = { version = "0.20", features = ["derive"] }
{%- if uses_regex %}
regex = "1"
{%- endif %}
{%- if uses_chrono %}
chrono = { version = "0.4", features = ["serde"] }
{%- endif %}
{%- if uses_uuid %}
uuid = { version = "1", features = ["serde"] }
{%- endif %}
