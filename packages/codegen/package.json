{
  "name": "@em/codegen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "em-codegen": "./bin/em-codegen.mjs"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "codegen": "node ./bin/em-codegen.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@em/spec": "workspace:*",
    "jiti": "^2.4.2",
    "nunjucks": "^3.2.4",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/nunjucks": "^3.2.6",
    "typescript": "^5.7.3"
  }
}
