/// Project-specific projection logic for `{{ name }}`.
///
/// Implement this trait in your own module; the generated code is fixed and
/// never edited by hand.
{% if projectionAsync %}///
/// The methods may perform side effects (for example persisting a view to a
/// database) and report failures through [`Self::Error`]. `position` is the
/// sequence position of the event being folded, so a handler can store it in
/// the row (`last_event_position`) and reject stale replays.
{% endif -%}
{% if projectionAsync %}#[async_trait::async_trait]
{% endif -%}
pub trait {{ name }}Reducer {
{% if projectionAsync %}    /// Error produced by the project-specific logic (e.g. a database error).
    type Error;

{% endif -%}
{% for event in artifact.projectionEvents -%}
    /// Project a `{{ event.rustName }}` into the {{ projectionKind | lower }}.
{% if projectionAsync %}    async fn on_{{ event.eventType }}(
        &self,
        state: &mut {{ name }},
        event: &{{ event.rustName }},
        position: SequencePosition,
    ) -> Result<(), Self::Error>;
{% else %}    fn on_{{ event.eventType }}(&self, state: &mut {{ name }}, event: &{{ event.rustName }});
{% endif -%}
{% endfor -%}
}

/// Errors returned by [`{{ name }}::load`].
#[derive(Debug)]
pub enum {{ name }}Error<{{ errGenerics }}> {
    /// The underlying event store failed.
    Store(event_store::Error<E>),
    /// An event payload could not be decoded.
    Decode(serde_json::Error),
{% if projectionAsync %}    /// The project's reducer logic failed.
    Reducer(R),
{% endif -%}
}

impl<{{ errBounds }}> std::fmt::Display for {{ name }}Error<{{ errGenerics }}> {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Self::Store(error) => write!(f, "event store error: {error:?}"),
            Self::Decode(error) => write!(f, "event decode error: {error}"),
{% if projectionAsync %}            Self::Reducer(error) => write!(f, "reducer error: {error:?}"),
{% endif -%}
        }
    }
}

impl<{{ errBounds }}> std::error::Error for {{ name }}Error<{{ errGenerics }}> {}

impl {{ name }} {
{% if projectionKind == "View" %}    /// Physical table this projection is materialized into.
    ///
