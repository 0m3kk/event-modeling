    /// checkpoint key in `view_checkpoints`.
    pub const TABLE_NAME: &'static str = "{{ artifact.fileName }}";

    /// Whether `event_type` is one of the event types this projection subscribes to.
    ///
    /// The projection worker uses this to skip views that cannot be affected by
    /// an appended event, mirroring `Query::matches_event_type` on the store.
{% if artifact.matchesAnyEventType %}    pub fn matches_event_type(_event_type: &str) -> bool {
        true
    }
{% elif not artifact.queryEventTypes | length %}    pub fn matches_event_type(_event_type: &str) -> bool {
        false
    }
{% else %}    pub fn matches_event_type(event_type: &str) -> bool {
        [{% for type in artifact.queryEventTypes %}"{{ type }}"{% if not loop.last %}, {% endif %}{% endfor %}].contains(&event_type)
    }
{% endif %}
{% endif %}    /// Create a projection with its params set and projected fields defaulted.
    ///
    /// Projected field types must implement `Default`; the generated data types
    /// do, so a projection can start empty and be filled by folding events.
    pub fn new(
{%- for field in artifact.params %}
        {{ field.rustName }}: {{ field.rustType }},
{%- endfor %}
    ) -> Self {
        Self {
{% for field in artifact.params -%}
            {{ field.rustName }},
{% endfor -%}
            ..Default::default()
        }
    }

    /// The DCB query for this projection, built from its params.
    pub fn query(&self) -> Query {
{% if artifact.queryItems | length -%}
        Query::from_items([
{% for item in artifact.queryItems -%}
            QueryItem::new(
                vec![{% for t in item.typeRefs %}{% if t.rustName %}{{ t.rustName }}::event_type().to_string(){% else %}"{{ t.literal }}".to_string(){% endif %}{% if not loop.last %}, {% endif %}{% endfor %}],
                vec![{% for tag in item.tags %}format!("{{ tag.tag }}:{}", self.{{ tag.rustName }}){% if not loop.last %}, {% endif %}{% endfor %}],
            ),
{% endfor -%}
        ])
{% else -%}
        Query::from_items(Vec::<QueryItem>::new())
{% endif -%}
    }

{% if projectionKind == "View" %}    /// The DCB query for the whole read model, without binding any tags.
    ///
    /// A materialized View is caught up for every entity at once, so it cannot
    /// filter on an instance's params. This keeps the event types but drops the
    /// tag values, mirroring the backend's class-level `View::query`.
    pub fn stream_query() -> Query {
{% if artifact.queryItems | length -%}
        Query::from_items([
{% for item in artifact.queryItems -%}
            QueryItem::new(
                vec![{% for t in item.typeRefs %}{% if t.rustName %}{{ t.rustName }}::event_type().to_string(){% else %}"{{ t.literal }}".to_string(){% endif %}{% if not loop.last %}, {% endif %}{% endfor %}],
                vec![],
            ),
{% endfor -%}
        ])
{% else -%}
        Query::from_items(Vec::<QueryItem>::new())
{% endif -%}
    }

{% endif -%}
    /// Read every matching event and fold it into this projection.
    ///
    /// Returns the projection and the [`SequencePosition`] of the last event it
    /// folded (if any), so a caller can pass it to an
    /// [`AppendCondition`](event_store::AppendCondition) when appending the
    /// events that follow the decision. Use [`Self::load_since`] to resume from
    /// a stored checkpoint and to learn how many events were applied.
    pub async fn load<E, R>(
        self,
        store: &E,
        reducer: &R,
    ) -> Result<(Self, Option<SequencePosition>), {{ name }}Error<{% if projectionAsync %}E::Error, R::Error{% else %}E::Error{% endif %}>>
    where
        E: EventStore,
        R: {{ name }}Reducer,
    {
        let (projection, position, _) = self.load_since(store, reducer, None).await?;
        Ok((projection, position))
    }

    /// Read matching events from `from` onward and fold them into this projection.
    ///
    /// `from` is inclusive, so a caller resuming from a checkpoint passes the
    /// stored position plus one (`position.saturating_add(1)`); `None` replays
    /// the whole stream. Returns the projection, the position of the last event
    /// it folded, and how many events were applied, so a catch-up driver can
    /// advance its checkpoint and report progress.
    ///
    /// This uses [`Self::query`], so it only folds the entity identified by the
    /// projection's params.
    pub async fn load_since<E, R>(
        self,
        store: &E,
        reducer: &R,
        from: Option<SequencePosition>,
    ) -> Result<(Self, Option<SequencePosition>, u64), {{ name }}Error<{% if projectionAsync %}E::Error, R::Error{% else %}E::Error{% endif %}>>
    where
        E: EventStore,
        R: {{ name }}Reducer,
    {
        let query = self.query();
        self.fold(store, reducer, from, query).await
    }

{% if projectionKind == "View" %}    /// Read the whole read model from `from` onward and fold it into this projection.
    ///
    /// Unlike [`Self::load_since`], the stream is not bound to this instance's
    /// params; it uses [`Self::stream_query`]. Call it on [`Default::default`]
    /// so a catch-up driver starts from an empty projection and replays every
    /// entity's events while the reducer writes each row idempotently.
    pub async fn load_stream_since<E, R>(
        self,
        store: &E,
        reducer: &R,
        from: Option<SequencePosition>,
    ) -> Result<(Self, Option<SequencePosition>, u64), {{ name }}Error<{% if projectionAsync %}E::Error, R::Error{% else %}E::Error{% endif %}>>
    where
        E: EventStore,
        R: {{ name }}Reducer,
    {
        let query = Self::stream_query();
        self.fold(store, reducer, from, query).await
    }

{% endif -%}
    /// Shared fold loop for the projection loaders.
    async fn fold<E, R>(
        mut self,
        store: &E,
        reducer: &R,
        from: Option<SequencePosition>,
        query: Query,
    ) -> Result<(Self, Option<SequencePosition>, u64), {{ name }}Error<{% if projectionAsync %}E::Error, R::Error{% else %}E::Error{% endif %}>>
    where
        E: EventStore,
        R: {{ name }}Reducer,
    {
{% if not artifact.projectionEvents | length %}        let _ = reducer;
{% endif -%}
        let mut stream = store.read(query, from).await.map_err({{ name }}Error::Store)?;
        let mut position: Option<SequencePosition> = None;
        let mut applied: u64 = 0;
        while let Some(item) = stream.next().await {
            let sequenced = item.map_err({{ name }}Error::Store)?;
            let event_position = sequenced.position;
            position = Some(event_position);
            let event = sequenced.event;
{% for event in artifact.projectionEvents -%}
{% if loop.first %}            if{% else %}            } else if{% endif %} event.event_type == {{ event.rustName }}::event_type() {
                let typed: {{ event.rustName }} =
                    serde_json::from_value(event.data).map_err({{ name }}Error::Decode)?;
{% if projectionAsync %}                reducer
                    .on_{{ event.eventType }}(&mut self, &typed, event_position)
                    .await
                    .map_err({{ name }}Error::Reducer)?;
{% else %}                reducer.on_{{ event.eventType }}(&mut self, &typed);
{% endif -%}
                applied += 1;
{% endfor -%}
{% if artifact.projectionEvents | length %}            }
{% endif -%}
        }
        Ok((self, position, applied))
    }
}
