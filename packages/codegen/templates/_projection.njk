use event_store::{EventStore, Query, QueryItem};
use futures_util::StreamExt;
use serde::{Deserialize, Serialize};

/// DCB projection for `{{ name }}`.
///
/// Params (identity) and projected fields share this struct. Implement
/// [`{{ name }}Reducer`] in your own module and pass it to [`{{ name }}::load`].
#[derive(Debug, Clone, Serialize, Deserialize, Default)]
#[serde(rename_all = "snake_case")]
pub struct {{ name }} {
{% for field in artifact.params -%}
{% if field.doc %}{{ field.doc | doccomment }}
{% endif -%}
    pub {{ field.rustName }}: {{ field.rustType }},
{% endfor -%}
{% for field in artifact.fields -%}
{% if field.doc %}{{ field.doc | doccomment }}
{% endif -%}
    pub {{ field.rustName }}: {{ field.rustType }},
{% endfor -%}
}

/// Project-specific projection logic for `{{ name }}`.
///
/// Implement this trait in your own module; the generated code is fixed and
/// never edited by hand. The methods may perform side effects (for example
/// persisting a view to a database) and report failures through
/// [`Self::Error`].
#[async_trait::async_trait]
pub trait {{ name }}Reducer {
    /// Error produced by the project-specific logic (e.g. a database error).
    type Error;

{% for event in artifact.projectionEvents -%}
    /// Project a `{{ event.rustName }}` into the {{ projectionKind | lower }}.
    async fn on_{{ event.eventType }}(&self, state: &mut {{ name }}, event: &{{ event.rustName }}) -> Result<(), Self::Error>;
{% endfor -%}
}

/// Errors returned by [`{{ name }}::load`].
#[derive(Debug)]
pub enum {{ name }}Error<E, R> {
    /// The underlying event store failed.
    Store(event_store::Error<E>),
    /// An event payload could not be decoded.
    Decode(serde_json::Error),
    /// The project's reducer logic failed.
    Reducer(R),
}

impl<E: std::fmt::Debug, R: std::fmt::Debug> std::fmt::Display for {{ name }}Error<E, R> {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Self::Store(error) => write!(f, "event store error: {error:?}"),
            Self::Decode(error) => write!(f, "event decode error: {error}"),
            Self::Reducer(error) => write!(f, "reducer error: {error:?}"),
        }
    }
}

impl<E: std::fmt::Debug, R: std::fmt::Debug> std::error::Error for {{ name }}Error<E, R> {}

impl {{ name }} {
    /// Create a projection with its params set and projected fields defaulted.
    ///
    /// Projected field types must implement `Default`; the generated data types
    /// do, so a projection can start empty and be filled by folding events.
    pub fn new(
{%- for field in artifact.params %}
        {{ field.rustName }}: {{ field.rustType }},
{%- endfor %}
    ) -> Self {
        Self {
{% for field in artifact.params -%}
            {{ field.rustName }},
{% endfor -%}
            ..Default::default()
        }
    }

    /// The DCB query for this projection, built from its params.
    pub fn query(&self) -> Query {
{% if artifact.queryItems | length -%}
        Query::from_items([
{% for item in artifact.queryItems -%}
            QueryItem::new(
                vec![{% for type in item.types %}"{{ type | snake }}".to_string(){% if not loop.last %}, {% endif %}{% endfor %}],
                vec![{% for tag in item.tags %}format!("{{ tag.tag }}:{}", self.{{ tag.rustName }}){% if not loop.last %}, {% endif %}{% endfor %}],
            ),
{% endfor -%}
        ])
{% else -%}
        Query::from_items(Vec::<QueryItem>::new())
{% endif -%}
    }

    /// Read every matching event and fold it into this projection.
    pub async fn load<E, R>(
        mut self,
        store: &E,
        reducer: &R,
    ) -> Result<Self, {{ name }}Error<E::Error, R::Error>>
    where
        E: EventStore,
        R: {{ name }}Reducer,
    {
{% if not artifact.projectionEvents | length %}        let _ = reducer;
{% endif -%}
        let query = self.query();
        let mut stream = store.read(query, None).await.map_err({{ name }}Error::Store)?;
        while let Some(item) = stream.next().await {
            let event = item.map_err({{ name }}Error::Store)?.event;
            match event.event_type.as_str() {
{% for event in artifact.projectionEvents -%}
                "{{ event.eventType }}" => {
                    let typed: {{ event.rustName }} =
                        serde_json::from_value(event.data).map_err({{ name }}Error::Decode)?;
                    reducer
                        .on_{{ event.eventType }}(&mut self, &typed)
                        .await
                        .map_err({{ name }}Error::Reducer)?;
                }
{% endfor -%}
                _ => {}
            }
        }
        Ok(self)
    }
}
