//! Active-passive leader election through a PostgreSQL advisory lock.
//!
//! Only the leader catches up the read models; the other replicas wait in
//! standby and take over if the leader releases the lock (on shutdown or when
//! its connection drops).

use std::time::Duration;

use sqlx::PgPool;
use sqlx::pool::PoolConnection;
use sqlx::postgres::Postgres;
use tokio::sync::watch;
use tokio::time::sleep;

use super::WorkerError;

/// Guard holding the session-level advisory lock of the active worker.
pub struct LeaderGuard {
    conn: PoolConnection<Postgres>,
    lock_id: i64,
}

impl LeaderGuard {
    /// Try to become the active worker, waiting in standby while another
    /// replica holds the lock.
    ///
    /// Returns `None` when `lock_id <= 0` (election disabled) or when shutdown
    /// was requested while waiting.
    pub async fn acquire(
        pool: &PgPool,
        lock_id: i64,
        retry_interval: Duration,
        shutdown_rx: &mut watch::Receiver<bool>,
    ) -> Result<Option<Self>, WorkerError> {
        if lock_id <= 0 {
            return Ok(None);
        }

        loop {
            if *shutdown_rx.borrow() {
                return Ok(None);
            }

            match pool.acquire().await {
                Ok(mut conn) => {
                    let acquired: Result<bool, sqlx::Error> =
                        sqlx::query_scalar("SELECT pg_try_advisory_lock($1)")
                            .bind(lock_id)
                            .fetch_one(&mut *conn)
                            .await;

                    match acquired {
                        Ok(true) => {
                            tracing::info!(
                                lock_id,
                                "acquired leader lock; running as the active worker"
                            );
                            return Ok(Some(Self { conn, lock_id }));
                        }
                        Ok(false) => {
                            tracing::info!(
                                lock_id,
                                "leader lock held by another instance; standby"
                            );
                        }
                        Err(error) => {
                            tracing::error!(%error, "failed to check the leader advisory lock");
                        }
                    }
                }
                Err(error) => {
                    tracing::error!(
                        %error,
                        "failed to acquire a database connection for the leader lock"
                    );
                }
            }

            tokio::select! {
                _ = shutdown_rx.changed() => {
                    return Ok(None);
                }
                _ = sleep(retry_interval) => {}
            }
        }
    }

    /// Release the advisory lock so a standby replica can take over.
    pub async fn release(mut self) {
        let _ = sqlx::query("SELECT pg_advisory_unlock($1)")
            .bind(self.lock_id)
            .execute(&mut *self.conn)
            .await;
        tracing::info!(lock_id = self.lock_id, "released leader advisory lock");
    }
}
