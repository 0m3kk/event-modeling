//! OpenAPI 3.1 document for the generated API (utoipa).

/// The OpenAPI document describing every command and query route.
#[derive(utoipa::OpenApi)]
#[openapi(
    info(title = "{{ crate.name }}", version = "{{ crate.version }}"),
    paths({% for route in routes %}super::router::{{ route.method }}{% if not loop.last %}, {% endif %}{% endfor %})
)]
pub struct ApiDoc;

/// Build the generated OpenAPI 3.1 document.
pub fn openapi() -> utoipa::openapi::OpenApi {
    <ApiDoc as utoipa::OpenApi>::openapi()
}
