//! HTTP API (axum) generated from the specification.
//!
//! Register a handler for every command and query on [`Api`], then pass the
//! registry to [`router`]. The generated transport deserializes requests,
//! builds the [`ExecutionContext`](crate::ExecutionContext) from request
//! headers, and serializes responses.

mod error;
mod extract;
mod router;
{% if crate.openapi %}mod openapi;
{% endif %}
pub use error::ApiError;
pub use router::router;
{% if crate.openapi %}pub use openapi::{openapi, ApiDoc};
{% endif %}
use std::sync::Arc;
{% for imp in handlerImports -%}
use {{ imp.path }}::{{ "{" }}{{ imp.names | join(", ") }}{{ "}" }};
{% endfor %}

/// Registry of the command and query handlers the HTTP API dispatches to.
///
/// Build it with [`Api::new`] and register each handler with its `with_*`
/// method:
///
/// ```ignore
/// let api = shop::apis::Api::new()
///     .with_place_order(PlaceOrderImpl)
///     .with_get_order(GetOrderImpl);
/// let app = shop::apis::router(api);
/// ```
///
/// A route whose handler is not registered answers `500`, so register every
/// route the spec declares.
pub struct Api<E> {
{% for route in routes -%}
    {{ route.method }}: Option<Arc<dyn {{ route.handlerType }}<Error = E> + Send + Sync>>,
{% endfor -%}
}

impl<E> Api<E> {
    /// Create a registry with no handlers registered.
    pub fn new() -> Self {
        Self::default()
    }
{% for route in routes %}
    /// Register the `{{ route.requestType }}` {{ route.subject }} handler.
    pub fn with_{{ route.method }}(
        mut self,
        handler: impl {{ route.handlerType }}<Error = E> + Send + Sync + 'static,
    ) -> Self {
        self.{{ route.method }} = Some(Arc::new(handler));
        self
    }
{%- endfor %}
}

impl<E> Default for Api<E> {
    fn default() -> Self {
        Self {
{% for route in routes -%}
            {{ route.method }}: None,
{% endfor -%}
        }
    }
}

impl<E> Clone for Api<E> {
    fn clone(&self) -> Self {
        Self {
{% for route in routes -%}
            {{ route.method }}: self.{{ route.method }}.clone(),
{% endfor -%}
        }
    }
}
