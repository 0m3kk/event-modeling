//! Projection registry the worker drives.
//!
//! Every View the spec declares has a `catchup` driver next to its reducer; the
//! registry runs the drivers whose query matches an appended event type, or all
//! of them for a periodic full catch-up.

use crate::{AppError, AppState};
use event_store::EventStore;

/// The set of read-model projections the worker catches up.
pub struct ProjectionRegistry<E, S = ()> {
    state: AppState<E, S>,
}

impl<E, S> ProjectionRegistry<E, S>
where
    E: EventStore + Send + Sync + 'static,
    E::Error: std::fmt::Debug,
    S: Send + Sync + 'static,
{
    /// Create a registry over the shared application state.
    pub fn new(state: AppState<E, S>) -> Self {
        Self { state }
    }

    /// The shared application state the projections read from.
    pub fn state(&self) -> &AppState<E, S> {
        &self.state
    }

    /// Catch up every managed read model.
    ///
    /// Returns the total number of events projected. A failing view stops the
    /// pass; the worker logs the error and retries on the next tick.
    pub async fn catchup_all(&self) -> Result<u64, AppError> {
        self.catchup_on_event("").await
    }

    /// Catch up only the views whose query subscribes to `event_type`.
    ///
    /// An empty `event_type` means "all views" (used by the polling ticker).
    /// The filtering mirrors `Query::matches_event_type` on the event store, so
    /// a notification for `OrderPlaced` does not replay unrelated views.
    pub async fn catchup_on_event(&self, event_type: &str) -> Result<u64, AppError> {
        let mut total = 0u64;
{% for view in projectionViews -%}
        if event_type.is_empty()
            || crate::domains::{{ view.domain }}::views::{{ view.fileName }}::matches_event_type(event_type)
        {
            total += crate::domains::{{ view.domain }}::views::{{ view.fileName }}::catchup(&self.state).await?;
        }
{% endfor -%}
        Ok(total)
    }
}
