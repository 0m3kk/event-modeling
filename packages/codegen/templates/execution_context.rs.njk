//! Contextual metadata captured from the execution environment and threaded
//! through command and query handlers.

use crate::DomainEvent;
use event_store::{Event, EventMetadata};
use serde::{Deserialize, Serialize};
use serde_json::Value;
use time::OffsetDateTime;

/// Contextual metadata captured from the execution environment (e.g. HTTP request, CLI invocation).
#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
pub struct ExecutionContext {
    /// Identity of the actor or caller.
    pub actor_id: Option<String>,
    /// Identity of the active tenant context.
    pub tenant_id: Option<String>,
    /// Correlation ID linking distributed operations.
    pub correlation_id: Option<String>,
    /// Causation ID identifying the preceding trigger.
    pub causation_id: Option<String>,
    /// OpenTelemetry Trace ID.
    pub trace_id: Option<String>,
    /// OpenTelemetry Span ID.
    pub span_id: Option<String>,
    /// Client IP address.
    pub client_ip: Option<String>,
    /// Client User-Agent string.
    pub user_agent: Option<String>,
    /// Additional context properties.
    pub extra: Option<Value>,
}

impl ExecutionContext {
    /// Creates an empty execution context.
    pub fn new() -> Self {
        Self::default()
    }

    /// Sets the actor ID.
    pub fn with_actor_id(mut self, actor_id: impl Into<String>) -> Self {
        self.actor_id = Some(actor_id.into());
        self
    }

    /// Sets the tenant ID.
    pub fn with_tenant_id(mut self, tenant_id: impl Into<String>) -> Self {
        self.tenant_id = Some(tenant_id.into());
        self
    }

    /// Sets the correlation ID.
    pub fn with_correlation_id(mut self, correlation_id: impl Into<String>) -> Self {
        self.correlation_id = Some(correlation_id.into());
        self
    }

    /// Sets the causation ID.
    pub fn with_causation_id(mut self, causation_id: impl Into<String>) -> Self {
        self.causation_id = Some(causation_id.into());
        self
    }

    /// Sets the trace ID.
    pub fn with_trace_id(mut self, trace_id: impl Into<String>) -> Self {
        self.trace_id = Some(trace_id.into());
        self
    }

    /// Sets the span ID.
    pub fn with_span_id(mut self, span_id: impl Into<String>) -> Self {
        self.span_id = Some(span_id.into());
        self
    }

    /// Sets the client IP address.
    pub fn with_client_ip(mut self, client_ip: impl Into<String>) -> Self {
        self.client_ip = Some(client_ip.into());
        self
    }

    /// Sets the user agent string.
    pub fn with_user_agent(mut self, user_agent: impl Into<String>) -> Self {
        self.user_agent = Some(user_agent.into());
        self
    }

    /// Sets custom extra metadata.
    pub fn with_extra(mut self, extra: Value) -> Self {
        self.extra = Some(extra);
        self
    }

    /// Builds an [`EventMetadata`] instance with the current UTC timestamp.
    pub fn to_metadata(&self) -> EventMetadata {
        self.to_metadata_at(OffsetDateTime::now_utc())
    }

    /// Builds an [`EventMetadata`] instance with a specific timestamp.
    pub fn to_metadata_at(&self, timestamp: OffsetDateTime) -> EventMetadata {
        EventMetadata {
            timestamp,
            actor_id: self.actor_id.clone(),
            correlation_id: self.correlation_id.clone(),
            causation_id: self.causation_id.clone(),
            trace_id: self.trace_id.clone(),
            span_id: self.span_id.clone(),
            client_ip: self.client_ip.clone(),
            user_agent: self.user_agent.clone(),
            extra: self.extra.clone(),
        }
    }

    /// Converts a single [`DomainEvent`] into an [`Event`] enriched with this context's metadata.
    pub fn create_store_event<E: DomainEvent>(
        &self,
        event: &E,
    ) -> Result<Event, serde_json::Error> {
        let metadata = self.to_metadata();
        event.to_store_event_with_metadata(&metadata)
    }

    /// Converts multiple [`DomainEvent`]s into [`Event`]s enriched with this context's metadata.
    pub fn create_store_events<'a, E: DomainEvent + 'a>(
        &self,
        events: impl IntoIterator<Item = &'a E>,
    ) -> Result<Vec<Event>, serde_json::Error> {
        let metadata = self.to_metadata();
        events
            .into_iter()
            .map(|e| e.to_store_event_with_metadata(&metadata))
            .collect()
    }
}
