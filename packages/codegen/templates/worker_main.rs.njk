//! Worker binary: initialize infrastructure, build the projection registry and
//! run the worker until Ctrl-C.
//!
//! Generated once; edit freely.

use {{ appCratePath }}::{AppState, ProjectionRegistry};
use event_store::PostgresEventStore;
use snapshot_store::PostgresSnapshotStore;
use telemetry::init_telemetry;
use tokio::signal;
use tokio::sync::watch;
use {{ workerCratePath }}::{Worker, WorkerConfig, WorkerSecret};

/// The concrete event store the worker projects from.
type Store = PostgresEventStore;

/// The concrete snapshot store the worker shares with the handlers.
type Snapshots = PostgresSnapshotStore;

/// Shared application state passed to the projections.
type State = AppState<Store, Snapshots>;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
    let config = WorkerConfig::load(None)?;
    let secret = WorkerSecret::load(None)?;

    // Held for the lifetime of the process; flushing on drop shuts the exporters
    // down cleanly.
    let _telemetry_guard = init_telemetry(&config.telemetry, Some(&secret.telemetry))?;

    let pool = config.postgres.init_pool(&secret.postgres).await?;
    event_store::EVENT_STORE_MIGRATOR.run(&pool).await?;
    snapshot_store::SNAPSHOT_STORE_MIGRATOR.run(&pool).await?;

    let event_store = PostgresEventStore::new(pool.clone());
    let snapshot_store = PostgresSnapshotStore::new(pool.clone());
    let state: State = AppState::new(event_store).with_snapshot_store(snapshot_store);
    let registry = ProjectionRegistry::new(state);

    let (shutdown_tx, shutdown_rx) = watch::channel(false);
    tokio::spawn(async move {
        let _ = signal::ctrl_c().await;
        let _ = shutdown_tx.send(true);
    });

    Worker::new(pool, registry, config.worker).run(shutdown_rx).await?;
    Ok(())
}
