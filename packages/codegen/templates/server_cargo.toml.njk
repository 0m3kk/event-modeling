[package]
name = "{{ serverCrate }}"
version = "{{ crate.version }}"
edition = "{{ crate.edition }}"

[dependencies]
{{ appCrate }} = { path = "{{ appFromServer }}" }
{{ crate.name }} = { path = "{{ baseFromServer }}" }
axum = "0.8"
tokio = { version = "1", features = ["macros", "rt-multi-thread", "net"{% if worker and workerPackage == "server" %}, "signal", "time"{% endif %}] }
tracing = "0.1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
serde_yaml = "0.9"
{% if worker and workerPackage == "server" -%}
sqlx = { version = "0.9", default-features = false, features = ["runtime-tokio", "postgres"] }
thiserror = "2"
{% endif -%}
{% for dep in serverDeps -%}
{{ dep }}
{% endfor -%}
