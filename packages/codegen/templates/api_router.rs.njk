//! Axum transport for the generated API.
//!
//! Register command and query handlers on [`Api`](super::Api); this module
//! deserializes requests, builds the [`ExecutionContext`] from headers,
//! dispatches to the registered handler and serializes the response.

use axum::Json;
use axum::extract::State;
use axum::response::{IntoResponse, Response};
use axum::routing::post;
use axum::Router;
use crate::ExecutionContext;
use super::{Api, ApiError};
{% for imp in typeImports -%}
use {{ imp.path }}::{{ "{" }}{{ imp.names | join(", ") }}{{ "}" }};
{% endfor %}

/// Build the axum router serving every command and query.
///
/// Register the handlers on the [`Api`](super::Api) registry first:
///
/// ```ignore
/// let app = shop::apis::router(my_api);
/// ```
pub fn router<E>(api: Api<E>) -> Router
where
    E: IntoResponse + Send + Sync + 'static,
{
    Router::new()
{% for route in routes -%}
        .route("{{ route.path }}", post({{ route.method }}::<E>))
{% endfor -%}
        .with_state(api)
}
{% for route in routes %}

{% if route.doc %}{{ route.doc | doccomment }}
{% endif -%}
{% if crate.openapi %}#[utoipa::path(
    post,
    path = "{{ route.path }}",
    tag = "{{ route.tag }}",
    request_body = {{ route.requestType }},
    responses({% if route.responseType %}(status = 200, body = {{ route.responseType }}){% else %}(status = 204){% endif %})
)]
{% endif -%}
pub(crate) async fn {{ route.method }}<E>(
    State(api): State<Api<E>>,
    ctx: ExecutionContext,
    Json({{ route.argName }}): Json<{{ route.requestType }}>,
) -> Response
where
    E: IntoResponse + Send + Sync + 'static,
{
    let Some(handler) = api.{{ route.method }}.as_ref() else {
        return ApiError::internal("no handler registered for {{ route.requestType }}").into_response();
    };
    match handler.handle(&ctx, {{ route.argName }}).await {
{% if route.responseType %}        Ok(response) => Json(response).into_response(),
{% else %}        Ok(()) => axum::http::StatusCode::NO_CONTENT.into_response(),
{% endif %}        Err(error) => error.into_response(),
    }
}
{% endfor -%}
