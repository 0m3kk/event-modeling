//! Server configuration and secrets, loaded from a file or environment
//! variables.
//!
//! Generated once; edit freely — add the settings your deployment needs.

use std::fs;
use std::path::Path;

use http_server::HttpConfig;
use jwt::{JwtConfig, JwtSecret};
use postgres_db::{PostgresConfig, PostgresSecret};
use serde::{Deserialize, Serialize};
use telemetry::{TelemetryConfig, TelemetrySecret};

/// Environment variable naming the configuration file to load.
pub const ENV_CONFIG_FILE: &str = "CONFIG_FILE";
/// Environment variable naming the secrets file to load.
pub const ENV_SECRET_FILE: &str = "SECRET_FILE";
/// Environment variable holding the PostgreSQL connection string.
pub const ENV_DATABASE_URL: &str = "DATABASE_URL";

/// Server configuration. Safe to check into source control.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
pub struct AppConfig {
    /// HTTP server settings (bind address, timeouts, CORS, cookies).
    #[serde(default)]
    pub http: HttpConfig,

    /// OpenTelemetry and logging settings.
    #[serde(default)]
    pub telemetry: TelemetryConfig,

    /// JWT token settings (token lifetime).
    #[serde(default)]
    pub jwt: JwtConfig,

    /// PostgreSQL connection pool settings.
    #[serde(default)]
    pub postgres: PostgresConfig,
}

impl Default for AppConfig {
    fn default() -> Self {
        Self {
            http: HttpConfig::default(),
            telemetry: TelemetryConfig::default(),
            jwt: JwtConfig::default(),
            postgres: PostgresConfig::default(),
        }
    }
}

impl AppConfig {
    /// Load configuration from `path`, then `CONFIG_FILE`, then defaults.
    ///
    /// `DATABASE_URL` overrides the host, port and database, so a deployment
    /// secret never has to be written to the config file.
    pub fn load(path: Option<&Path>) -> Result<Self, Box<dyn std::error::Error + Send + Sync>> {
        let mut config = if let Some(path) = path {
            load_file(path)?
        } else if let Ok(env_path) = std::env::var(ENV_CONFIG_FILE) {
            load_file(Path::new(&env_path))?
        } else {
            Self::default()
        };

        apply_database_url_to_config(&mut config.postgres);
        Ok(config)
    }
}

/// Server secrets. Load from a file or the environment; never commit these.
#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, Default)]
pub struct AppSecret {
    /// OpenTelemetry export credentials.
    #[serde(default)]
    pub telemetry: TelemetrySecret,

    /// JWT signing secret.
    #[serde(default)]
    pub jwt: JwtSecret,

    /// PostgreSQL credentials.
    #[serde(default)]
    pub postgres: PostgresSecret,
}

impl AppSecret {
    /// Load secrets from `path`, then `SECRET_FILE`, then defaults.
    ///
    /// `DATABASE_URL` overrides the username and password.
    pub fn load(path: Option<&Path>) -> Result<Self, Box<dyn std::error::Error + Send + Sync>> {
        let mut secret = if let Some(path) = path {
            load_file(path)?
        } else if let Ok(env_path) = std::env::var(ENV_SECRET_FILE) {
            load_file(Path::new(&env_path))?
        } else {
            Self::default()
        };

        apply_database_url_to_secret(&mut secret.postgres);
        Ok(secret)
    }
}

/// Overrides the connection host, port and database from `DATABASE_URL`.
fn apply_database_url_to_config(config: &mut PostgresConfig) {
    if let Ok(url) = std::env::var(ENV_DATABASE_URL)
        && let Ok(parsed) = url::Url::parse(&url)
    {
        if let Some(host) = parsed.host_str() {
            config.host = host.to_string();
        }
        if let Some(port) = parsed.port() {
            config.port = port;
        }
        let database = parsed.path().trim_start_matches('/');
        if !database.is_empty() {
            config.database = database.to_string();
        }
    }
}

/// Overrides the credentials from `DATABASE_URL`.
fn apply_database_url_to_secret(secret: &mut PostgresSecret) {
    if let Ok(url) = std::env::var(ENV_DATABASE_URL)
        && let Ok(parsed) = url::Url::parse(&url)
    {
        let username = parsed.username();
        if !username.is_empty() {
            secret.username = username.to_string();
        }
        if let Some(password) = parsed.password() {
            secret.password = password.to_string();
        }
    }
}

fn load_file<T: for<'de> Deserialize<'de>>(
    path: &Path,
) -> Result<T, Box<dyn std::error::Error + Send + Sync>> {
    let content = fs::read_to_string(path)?;
    let parsed: T = match path.extension().and_then(|ext| ext.to_str()) {
        Some("json") => serde_json::from_str(&content)?,
        _ => serde_yaml::from_str(&content)?,
    };
    Ok(parsed)
}
