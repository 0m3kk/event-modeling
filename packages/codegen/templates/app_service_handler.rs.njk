{% if item.usesPrelude %}use {{ crate.name }}::prelude::*;
{% endif -%}
use {{ crate.name }}::{{ item.contractModulePath | join("::") }}::{{ item.rustName }};
{% for method in item.methods -%}
{% if method.resultTypeName %}use {{ crate.name }}::{{ item.contractModulePath | join("::") }}::{{ method.resultTypeName }};
{% endif -%}
{% endfor %}
/// Implementation of the `{{ item.rustName }}` service.
pub struct {{ item.implType }};

#[async_trait::async_trait]
impl {{ item.rustName }} for {{ item.implType }} {
{% for method in item.methods -%}
    async fn {{ method.rustName }}(&self{% for param in method.params %}, _{{ param.rustName }}: {{ param.rustType }}{% endfor %}) -> {{ method.returnType }} {
        {{ stubs }}!("implement {{ item.rustName }}::{{ method.rustName }}")
    }
{% endfor -%}
}
