//! Shared server state and store initialization.
//!
//! Swap `Store`/`Snapshots` for other implementations (mocks in tests, different
//! backends in production) and the application handlers keep working unchanged.

use {{ appCratePath }}::AppState;
use event_store::PostgresEventStore;
use snapshot_store::PostgresSnapshotStore;

use crate::config::{AppConfig, AppSecret};

/// The concrete event store the server runs against.
pub type Store = PostgresEventStore;

/// The concrete snapshot store the server runs against.
pub type Snapshots = PostgresSnapshotStore;

/// Shared application state passed to every handler.
pub type State = AppState<Store, Snapshots>;

/// Connect to PostgreSQL, provision the store schemas, and build the shared
/// application state.
///
/// The pool is created with [`PostgresConfig::init_pool`], which also starts the
/// background pool-metrics monitor. Both stores share it.
///
/// [`PostgresConfig::init_pool`]: postgres_db::PostgresConfig::init_pool
pub async fn build_state(
    config: &AppConfig,
    secret: &AppSecret,
) -> Result<State, Box<dyn std::error::Error + Send + Sync>> {
    let pool = config.postgres.init_pool(&secret.postgres).await?;

    // Applies every pending store migration (idempotent on repeat runs).
    event_store::EVENT_STORE_MIGRATOR.run(&pool).await?;
    snapshot_store::SNAPSHOT_STORE_MIGRATOR.run(&pool).await?;

    let event_store = PostgresEventStore::new(pool.clone());
    let snapshot_store = PostgresSnapshotStore::new({% if hasViews %}pool.clone(){% else %}pool{% endif %});

    let state = AppState::new(event_store).with_snapshot_store(snapshot_store);
{% if hasViews %}
    Ok(state.with_pool(pool))
{% else %}
    Ok(state)
{% endif %}
}
