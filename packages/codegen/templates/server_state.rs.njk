//! Shared server state and event-store initialization.
//!
//! Generated once; edit freely — swap `Store` for another [`EventStore`]
//! implementation (a mock in tests, a different backend in production) and the
//! application handlers keep working unchanged.
//!
//! [`EventStore`]: event_store::EventStore

use {{ appCratePath }}::AppState;
use event_store::PostgresEventStore;

/// The concrete event store the server runs against.
pub type Store = PostgresEventStore;

/// Shared application state passed to every handler.
pub type State = AppState<Store>;

/// Connect to PostgreSQL, provision the event-store schema, and build the
/// shared application state.
pub async fn build_state(
    database_url: &str,
) -> Result<State, Box<dyn std::error::Error + Send + Sync>> {
    let pool = sqlx::PgPool::connect(database_url).await?;
    // Applies every pending event-store migration (idempotent on repeat runs).
    event_store::EVENT_STORE_MIGRATOR.run(&pool).await?;
    Ok(AppState::new(PostgresEventStore::new(pool)))
}
