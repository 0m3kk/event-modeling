use {{ crate.name }}::transports::Api;
{% for handler in handlers -%}
use crate::{{ handler.appPath }}::{{ handler.useCaseType }};
{% endfor -%}
use crate::{AppError, AppState};

/// Register every command and query handler on the generated API registry.
///
/// Regenerated from the spec: a new command/query adds a `with_*` call here, so
/// a route never silently answers `500` because its handler was forgotten.
/// Generic over the stores so the server picks the concrete ones.
pub fn register<E, S>(api: Api<AppError>, state: AppState<E, S>) -> Api<AppError>
where
    E: Send + Sync + 'static,
    S: Send + Sync + 'static,
{
    api
{% for handler in handlers -%}
        .with_{{ handler.method }}({{ handler.useCaseType }}::new(state.clone()))
{% endfor -%}
}
