use std::sync::Arc;

use config::{AppConfig, AppSecret};
use jwt::JwtService;
use router::create_router;
use state::build_state;
use telemetry::init_telemetry;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
    let config = AppConfig::load(None)?;
    let secret = AppSecret::load(None)?;

    // Held for the lifetime of the process; flushing on drop shuts the exporters
    // down cleanly.
    let _telemetry_guard = init_telemetry(&config.telemetry, Some(&secret.telemetry))?;

    let jwt = Arc::new(JwtService::new(&secret.jwt.secret, config.jwt.clone()));
    let state = build_state(&config, &secret).await?;
{% if worker and workerPackage == "server" %}    spawn_projection_worker(&config, &secret, state.clone()).await?;
{% endif %}
    let app = create_router(state, &config.http, jwt);

    http_server::serve(&config.http, app).await?;
    Ok(())
}
{% if worker and workerPackage == "server" %}
/// Start the background projection worker alongside the HTTP server.
///
/// It gets its own pool (the worker holds a dedicated connection for
/// `LISTEN`/`NOTIFY` and its leader lock) and shuts down with Ctrl-C.
async fn spawn_projection_worker(
    config: &AppConfig,
    secret: &AppSecret,
    state: state::State,
) -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
    let pool = config.postgres.init_pool(&secret.postgres).await?;
    let registry = {{ appCratePath }}::ProjectionRegistry::new(state);
    let (shutdown_tx, shutdown_rx) = tokio::sync::watch::channel(false);

    tokio::spawn(worker::run(
        pool,
        registry,
        worker::WorkerOptions::default(),
        shutdown_rx,
    ));
    tokio::spawn(async move {
        let _ = tokio::signal::ctrl_c().await;
        let _ = shutdown_tx.send(true);
    });

    Ok(())
}
