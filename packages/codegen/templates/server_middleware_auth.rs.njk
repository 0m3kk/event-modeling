//! Authentication middleware.
//!
//! Verifies the bearer token with the configured [`JwtService`] and forwards
//! the verified subject to the generated [`ExecutionContext`] by setting the
//! actor header the extractor reads. Requests without a valid, unexpired token
//! are rejected with `401`.
//!
//! [`ExecutionContext`]: {{ crate.name }}::ExecutionContext

use std::sync::Arc;

use axum::extract::{Request, State};
use axum::http::{HeaderValue, StatusCode, header};
use axum::middleware::Next;
use axum::response::{IntoResponse, Response};
use http_server::ErrorResponse;
use jwt::JwtService;

/// Header the generated `ExecutionContext` extractor reads the actor from.
pub const ACTOR_HEADER: &str = "x-actor-id";

/// Require a valid bearer token and expose its subject as the request actor.
///
/// Wire it with `from_fn_with_state(jwt, require_auth)` so the service is
/// shared, not rebuilt per request.
pub async fn require_auth(
    State(jwt): State<Arc<JwtService>>,
    mut request: Request,
    next: Next,
) -> Result<Response, Response> {
    let token = match bearer_token(request.headers()) {
        Some(token) => token,
        None => return Err(unauthorized("Authentication token is missing")),
    };

    let claims = jwt.verify_token::<()>(&token).map_err(|error| {
        unauthorized(format!("Invalid or expired authentication token: {error}"))
    })?;

    // The verified `sub` claim becomes the actor id downstream.
    if let Ok(value) = HeaderValue::from_str(&claims.sub) {
        request.headers_mut().insert(ACTOR_HEADER, value);
    }

    Ok(next.run(request).await)
}

/// Reads the token from an `Authorization: Bearer <token>` header, falling back
/// to a pre-set [`ACTOR_HEADER`] (e.g. from an upstream gateway) for local use.
fn bearer_token(headers: &axum::http::HeaderMap) -> Option<String> {
    headers
        .get(header::AUTHORIZATION)
        .and_then(|value| value.to_str().ok())
        .and_then(|value| value.strip_prefix("Bearer "))
        .map(str::trim)
        .filter(|token| !token.is_empty())
        .map(str::to_string)
}

/// A `401 Unauthorized` response with the standard error payload.
fn unauthorized(message: impl Into<String>) -> Response {
    ErrorResponse::new(StatusCode::UNAUTHORIZED, "UNAUTHORIZED", message).into_response()
}
