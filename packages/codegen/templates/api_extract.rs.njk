//! Builds an [`ExecutionContext`](crate::ExecutionContext) from HTTP request
//! headers, so command and query handlers receive request metadata.

use axum::extract::FromRequestParts;
use axum::http::request::Parts;
use crate::ExecutionContext;

/// Reads a header as an owned string, if present and valid UTF-8.
fn header(parts: &Parts, name: &str) -> Option<String> {
    parts
        .headers
        .get(name)
        .and_then(|value| value.to_str().ok())
        .map(str::to_string)
}

impl<S> FromRequestParts<S> for ExecutionContext
where
    S: Send + Sync,
{
    type Rejection = std::convert::Infallible;

    async fn from_request_parts(parts: &mut Parts, _state: &S) -> Result<Self, Self::Rejection> {
        let mut ctx = ExecutionContext::new();
        ctx.actor_id = header(parts, "x-actor-id");
        ctx.tenant_id = header(parts, "x-tenant-id");
        ctx.correlation_id = header(parts, "x-correlation-id");
        ctx.causation_id = header(parts, "x-causation-id");
        ctx.user_agent = header(parts, "user-agent");

        // W3C `traceparent`: `version-trace-id-span-id-flags`.
        if let Some(traceparent) = header(parts, "traceparent") {
            let mut segments = traceparent.split('-');
            let _version = segments.next();
            ctx.trace_id = segments.next().map(str::to_string);
            ctx.span_id = segments.next().map(str::to_string);
        }
        if ctx.trace_id.is_none() {
            ctx.trace_id = header(parts, "x-trace-id");
        }
        if ctx.span_id.is_none() {
            ctx.span_id = header(parts, "x-span-id");
        }

        // `x-forwarded-for` is a comma-separated list; the first entry is the client.
        ctx.client_ip = header(parts, "x-forwarded-for")
            .and_then(|value| value.split(',').next().map(|ip| ip.trim().to_string()))
            .filter(|ip| !ip.is_empty())
            .or_else(|| header(parts, "x-real-ip"));

        Ok(ctx)
    }
}
