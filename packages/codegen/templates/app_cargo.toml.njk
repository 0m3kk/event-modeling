[package]
name = "{{ appCrate }}"
version = "{{ crate.version }}"
edition = "{{ crate.edition }}"

[dependencies]
{{ crate.name }} = { path = "{{ baseFromApp }}" }
async-trait = "0.1"
tracing = "0.1"
{% if hasViews -%}
sqlx = { version = "0.9", default-features = false, features = ["runtime-tokio", "postgres"] }
{% endif -%}
{% for dep in appDeps -%}
{{ dep }}
{% endfor -%}
