/// Build the application router.
///
/// `require_auth` is applied to the empty `protected` router; add the routes
/// that need an authenticated caller there. Everything else is public.
pub fn create_router(state: State, config: &HttpConfig, jwt: Arc<JwtService>) -> Router {
    let api = {{ crate.name }}::apis::router({{ appCratePath }}::register(
        {{ crate.name }}::apis::Api::<{{ appCratePath }}::AppError>::new(),
        state,
    ));

    let protected = Router::new().route_layer(from_fn_with_state(jwt, require_auth));

