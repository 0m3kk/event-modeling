/// Build the application router.
///
/// Routes that need an authenticated caller go on the `protected` router,
/// which runs `require_auth`; everything else is public.
pub fn create_router(state: State, config: &HttpConfig, jwt: Arc<JwtService>) -> Router {
    let api = {{ crate.name }}::apis::router({{ appCratePath }}::register(
        {{ crate.name }}::apis::Api::<{{ appCratePath }}::AppError>::new(),
        state,
    ));

    // The example `me` route reports the authenticated caller's identity.
    let protected = Router::new()
        .route(me::ME_PATH, get(me::me))
        .route_layer(from_fn_with_state(jwt, require_auth));

    let routes = Router::new().merge(api).merge(protected);
    http_server::apply_middleware(http_server::init_router().merge(routes), config)
