# Example secrets. Copy to `secrets.yaml` (or point SECRET_FILE at a copy).
# Never commit the real file.
telemetry:
  # OTLP export authorization, e.g. "Basic <base64>" or "Bearer <token>".
  # authorization: null
  headers: {}

jwt:
  # HMAC signing key; use a long random value in production.
  secret: change_me_super_secret_jwt_key_at_least_32_bytes_long
