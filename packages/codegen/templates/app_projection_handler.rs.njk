/// Catch up the `{{ item.rustName }}` read model from its checkpoint.
///
/// The driver resumes at the position stored in `view_checkpoints`, folds every
/// matching event through the reducer, and advances the checkpoint to the last
/// applied event. Reducer handlers write the rows (typically an idempotent
/// `INSERT ... ON CONFLICT` against `{{ item.rustName }}::TABLE_NAME`), so a
/// crash between folding and checkpointing only replays events, never loses
/// them.
pub async fn catchup<E, S>(state: &AppState<E, S>) -> Result<u64, AppError>
where
    E: EventStore + Send + Sync + 'static,
    E::Error: std::fmt::Debug,
    S: Send + Sync + 'static,
{
    let pool = state
        .pool()
        .ok_or_else(|| internal("the application state has no PostgreSQL pool"))?;
    let last = last_position(pool, {{ item.rustName }}::TABLE_NAME)
        .await
        .map_err(internal)?;
    let from = last.map(|position| position.saturating_add(1));

    let reducer = {{ item.implType }}::new(state.clone());
    let (_view, position, applied) = {{ item.rustName }}::default()
        .load_stream_since(state.event_store.as_ref(), &reducer, from)
        .await
        .map_err(|error| internal(format!("{error:?}")))?;

    if let Some(position) = position {
        update_position(pool, {{ item.rustName }}::TABLE_NAME, position)
            .await
            .map_err(internal)?;
    }
    Ok(applied)
}
